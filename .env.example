# Copy to .env locally; never commit the populated .env file.
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional PostgreSQL connection URL. Without it, the app uses local SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/coats

# Optional production transport-security controls:
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_HSTS_PRELOAD=false

# Example account provisioning variables (use unique strong values):
# COATS_SUPERVISOR_PASSWORD_DIG_ATS=
# COATS_SUPERVISOR_PASSWORD_SP_ATS_HQ=
# COATS_CASE_PASSWORD_ADSP_HQ=
# COATS_CASE_PASSWORD_INSADMIN=
